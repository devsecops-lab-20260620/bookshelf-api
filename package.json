{
  "name": "bookshelf-api",
  "version": "1.0.0",
  "description": "Bookshelf システムの REST API サーバー。コンテナ実行を前提とし、後段の PostgreSQL と接続する。GitHub Foundations の学習用リポジトリ。",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsecops-lab-20260620/bookshelf-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/devsecops-lab-20260620/bookshelf-api/issues"
  },
  "homepage": "https://github.com/devsecops-lab-20260620/bookshelf-api#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
